    "expo-image-picker": "~57.0.14",
    "expo-linking": "~57.0.8",
    "expo-location": "~57.0.14",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "laravel-echo": "^2.4.0",
    "pusher-js": "^8.6.0",
    "react": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
